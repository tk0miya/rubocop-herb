# Supplemental signatures for the `rubocop` gem.
#
# The version shipped via rbs_collection does not declare the methods below.
# RuboCop::Herb::CommentConfig overrides CommentConfig#cop_enabled_at_lines? and
# calls Cop::Base#cop_name, so declare them here.
# Herb/Linting cop resolves herb-lint from ConfigFinder.project_root and checks
# CommentConfig#cop_enabled_at_line? before reporting the startup error. It reports offenses in empty files
# with Cop::Base#add_global_offense.
# Herb/IgnoredCopDirective cop detects rubocop directives with DirectiveComment::DIRECTIVE_COMMENT_REGEXP.
# CorrectionValidator and CopCorrectionGuard create Corrector objects.
# ReparsedEquivalenceAdapter is prepended to Cop::ReparsedEquivalence (rubocop 1.92.0+).
# LineLengthAdapter is prepended to Cop::Layout::LineLength.

module RuboCop
  module ConfigFinder
    def self.project_root: () -> String?
  end

  class DirectiveComment
    DIRECTIVE_COMMENT_REGEXP: Regexp
  end

  class CommentConfig
    def cop_enabled_at_line?: (Cop::Base | String cop, Integer line_number) -> bool
    def cop_enabled_at_lines?: (Cop::Base | String cop, Integer first_line, Integer last_line) -> bool
  end

  module Cop
    class Base
      def cop_name: () -> String
      def add_global_offense: (?String? message, ?severity: Symbol?) -> void
    end

    class Corrector
      def initialize: (Parser::Source::Buffer | AST::ProcessedSource | Base source) -> void
    end

    module ReparsedEquivalence
    end

    module Layout
      class LineLength < Base
      end
    end
  end
end
