# Supplemental signatures for the `rubocop` gem.
#
# The version shipped via rbs_collection does not declare the methods below.
# RuboCop::Herb::CommentConfig overrides CommentConfig#cop_enabled_at_lines? and
# calls Cop::Base#cop_name, so declare them here.
# Herb/Linting cop resolves herb-lint from ConfigFinder.project_root and checks
# CommentConfig#cop_enabled_at_line? before reporting the startup error.

module RuboCop
  module ConfigFinder
    def self.project_root: () -> String?
  end

  class CommentConfig
    def cop_enabled_at_line?: (Cop::Base | String cop, Integer line_number) -> bool
    def cop_enabled_at_lines?: (Cop::Base | String cop, Integer first_line, Integer last_line) -> bool
  end

  module Cop
    class Base
      def cop_name: () -> String
    end
  end
end
